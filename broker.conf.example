# copy to broker.conf and adjust (paths relative to cwd).
# broker reads only server keys; libmessagebroker reads only client keys.

# server keys

data_dir = ./data
listen_port = 3490

# optional follower URL (omit or blank to disable leader -> follower forwarding).
replica_host =
# if zero, defaults to listen_port when replica_host is set.
replica_port = 0

# limit wire request size (header + topic + key + payload), bytes.
max_request_frame_bytes = 1048576

log_topic_actions = true
log_consume_miss_actions = false
log_client_io = true

# client keys

# comma-separated host:port (IPv6 must be [addr]:port)
# only one address is strictly necessary
brokers = 127.0.0.1:3490
#brokers = 127.0.0.1:3490,127.0.0.1:3491
